# Server Configuration
PORT=3001

# Google Gemini API (Free Tier)
# Recommended free-tier models: gemini-3.5-flash-lite or gemini-3.8-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Contact Form Email (SendGrid - Optional)
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_TO=recipient@example.com
EMAIL_FROM=verified_sender@example.com

# OSINT External APIs (Optional)
HIBP_API_KEY=your_haveibeenpwned_api_key_here
