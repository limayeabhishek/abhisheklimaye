{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/Abhishek__Limaye.pdf",
      "destination": "/Abhishek%20Limaye.pdf",
      "permanent": true
    },
    {
      "source": "/tools/port-scanner",
      "destination": "/#toolkit",
      "permanent": false
    },
    {
      "source": "/tools/pass-check",
      "destination": "/#toolkit",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
